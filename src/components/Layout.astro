---
import { ClientRouter } from "astro:transitions";
import dmSansLatin from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import plusJakartaLatin from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url";
import Footer from "./Footer.astro";
import { CommandBar } from "./react/CommandBar";
import { Navbar } from "./react/Navbar";
import { getLangFromUrl, localePath } from "../i18n/utils";
import { getCommandPosts } from "../lib/posts";
import type { Accent } from "../lib/palette";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  variant?: "home" | "page" | "article";
  heading?: string;
  primary?: Accent;
}

const {
  title,
  description = "Learning and building cool things out there.",
  ogType = "website",
  variant = "page",
  heading,
  primary = "cyan",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const posts = await getCommandPosts();
const ptHref = new URL(localePath(Astro.url.pathname, "pt", posts), Astro.site);
const enHref = new URL(localePath(Astro.url.pathname, "en", posts), Astro.site);
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const htmlLang = lang === "en" ? "en" : "pt";
const article = variant === "article";
const pageWidth = article ? "max-w-288" : "max-w-200";
---

<!doctype html>
<html lang={htmlLang} class="touch-manipulation overscroll-contain">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08070b" />
    {
      googleVerification && (
        <meta name="google-site-verification" content={googleVerification} />
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="pt" href={ptHref.href} />
    <link rel="alternate" hreflang="en" href={enHref.href} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL("/pt/", Astro.site).href}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="João Silva"
      href="/rss.xml"
    />
    <link
      rel="preload"
      href={plusJakartaLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={dmSansLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="João Silva" />
    <meta property="og:locale" content={lang === "pt" ? "pt_BR" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "pt" ? "en_US" : "pt_BR"}
    />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <div class="relative z-0 flex min-h-screen flex-col">
      <Navbar
        client:load
        transition:persist="site-nav"
        initialPath={Astro.url.pathname}
        posts={posts}
      />
      {
        variant === "home" ? (
          <main
            data-accent={primary}
            class="mx-auto flex w-full max-w-200 flex-1 items-start py-14 md:w-200 md:py-28"
          >
            <div class="mx-5 mt-40 mb-5 flex w-full max-w-190 flex-col items-start md:mt-64">
              <slot />
            </div>
          </main>
        ) : (
          <main
            data-accent={primary}
            class:list={[
              "mx-auto flex w-full flex-1 items-start pt-32 pb-14 md:py-28",
              pageWidth,
            ]}
          >
            <div class="w-full py-5 text-base leading-8.5">
              <div class:list={["mx-auto px-5", pageWidth]}>
                {heading && <h1>{heading}</h1>}
                <slot />
              </div>
            </div>
          </main>
        )
      }
      <Footer />
    </div>
    <CommandBar
      client:load
      transition:persist="command-bar"
      initialPath={Astro.url.pathname}
      posts={posts}
    />
  </body>
</html>
