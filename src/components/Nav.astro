---
const currentPath = Astro.url.pathname;
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { PhRss } from "phosphor-icons-astro";
import Logo from "../assets/images/logo.png";
import LanguageSelector from "./LanguageSelector.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav class="nav">
  <a href={`/${lang}`} class="nav-brand">
    <img src={Logo.src} alt="@odevjoao" class="nav-logo" />
  </a>
  <div class="nav-actions">
    <div class="nav-links">
      <a
        href={`/${lang}/about`}
        class={currentPath === "/about" || currentPath === "/about/"
          ? "active"
          : ""}
      >
        <span data-i18n="about">{t("nav.about")}</span>
      </a>
      <a
        href={`/${lang}/search`}
        class={currentPath === "/search" || currentPath === "/search/"
          ? "active"
          : ""}
      >
        <span data-i18n="search">{t("nav.search")}</span>
      </a>

      <LanguageSelector />

      <a class="rss-link" href="/rss.xml">
        <span>
          <PhRss size={24} />
        </span>
      </a>
    </div>
  </div>
</nav>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-lg);
    padding-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-logo {
    width: 64px;
    height: 64px;
    border-radius: 9999px;
    object-fit: cover;
    display: inline-block;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .nav-links a {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--color-text);
  }

  .nav-links .lang-selector {
    margin-left: 0;
  }

  .rss-link {
    padding-top: 4px;
  }

  @media (max-width: 640px) {
    .nav {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-actions {
      width: 100%;
      justify-content: flex-start;
      gap: 0.75rem;
    }

    .nav-links {
      width: 100%;
      justify-content: flex-start;
      gap: 0.75rem;
    }
  }
</style>
