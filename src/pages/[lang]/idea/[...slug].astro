---
import Layout from "../../../components/Layout.astro";
import { TableOfContents } from "../../../components/react/TableOfContents";
import { languages } from "../../../i18n/ui";
import { getLangFromUrl, otherLang, useTranslations } from "../../../i18n/utils";
import {
  formatPostDate,
  getPosts,
  postHref,
  postLang,
  postSlug,
} from "../../../lib/posts";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { lang: postLang(post), slug: postSlug(post) },
    props: { post },
  }));
}

const post = Astro.props.post;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content, headings } = await render(post);
const slug = postSlug(post);
const postUrl = new URL(`/${lang}/idea/${slug}`, Astro.site).href;
const displayDate = formatPostDate(post.data.date, lang);
const kindLabel =
  post.data.kind === "essay" ? t("articles.kind.essay") : t("articles.kind.note");
const indexHref = `/${lang}/ideas`;
const other = otherLang(lang);
const translationHref = post.data.translation
  ? `/${other}/idea/${post.data.translation}`
  : null;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const latest = (await getPosts(lang))
  .filter((item) => item.id !== post.id)
  .slice(0, 8);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  inLanguage: lang === "pt" ? "pt-BR" : "en",
  articleSection: kindLabel,
  keywords: post.data.tags.join(", "),
  url: postUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  author: {
    "@type": "Person",
    name: "João Silva",
    url: "https://joaosilva.dev.br",
  },
  publisher: {
    "@type": "Person",
    name: "João Silva",
    url: "https://joaosilva.dev.br",
  },
};
---

<Layout
  title={`${post.data.title} // João Silva`}
  description={post.data.description}
  ogType="article"
  variant="article"
  primary="pink"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <div class="lg:grid lg:grid-cols-[minmax(0,42rem)_13.5rem] lg:items-start lg:justify-center lg:gap-12">
    <div class="min-w-0">
  <p class="m-0 border-b border-hover pb-3">
    <a href={indexHref} class="border-0 text-sm text-secondary italic no-underline">
      ← {t("articles.index")}
    </a>
  </p>
  <TableOfContents
    client:load
    placement="inline"
    label={t("articles.toc")}
    headings={toc}
  />
  <header class="mt-8 mb-8">
    <h1 class="mb-3">{post.data.title}</h1>
    <p class="m-0 flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm">
      <span>
        {t("articles.by")} <a href={`/${lang}/about`}>João Silva</a>
      </span>
      <time datetime={post.data.date.toISOString()}>{displayDate}</time>
      <a href={`${indexHref}?kind=${post.data.kind}`}>{kindLabel}</a>
    </p>
    {
      translationHref && (
        <p class="mt-3 mb-0 text-sm italic">
          {t("articles.translations")}:{" "}
          <a href={translationHref} hrefLang={other} lang={other}>
            {languages[other]}
          </a>
        </p>
      )
    }
  </header>
  <div class="prose">
    <Content />
  </div>
  <footer class="mt-12 border-t border-hover pt-6">
    {
      post.data.tags.length > 0 && (
        <p class="text-sm">
          {t("articles.tagged")}:{" "}
          {post.data.tags.map((tag) => (
            <a
              href={`${indexHref}?tag=${encodeURIComponent(tag)}`}
              class="mr-3 text-sm"
            >
              #{tag}
            </a>
          ))}
        </p>
      )
    }
    {
      latest.length > 0 && (
        <>
          <h2>{t("articles.latest")}</h2>
          <ul class="m-0 list-none p-0">
            {latest.map((item) => {
              const itemDate = formatPostDate(item.data.date, lang);
              return (
                <li class="border-b border-hover">
                  <a
                    href={postHref(item)}
                    class="flex items-baseline gap-4 border-0 py-3 no-underline"
                  >
                    <time datetime={item.data.date.toISOString()} class="shrink-0 text-sm text-secondary">
                      {itemDate}
                    </time>
                    <span class="text-primary">{item.data.title}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </>
      )
    }
    <p>
      <a href={indexHref}>{t("articles.seeAll")}</a>
    </p>
  </footer>
    </div>
    <TableOfContents
      client:load
      placement="sidebar"
      label={t("articles.toc")}
      headings={toc}
    />
  </div>
</Layout>
